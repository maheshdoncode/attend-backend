    {
      "name": "07 - Deduction Policies",
      "item": [
        {
          "name": "Create Deduction Policy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Late Arrival\",\n  \"condition_type\": \"late_arrival\",\n  \"threshold_minutes\": 10,\n  \"deduction_type\": \"fixed_minutes\",\n  \"deduction_minutes\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/policies",
              "host": [
                "{{baseUrl}}"
